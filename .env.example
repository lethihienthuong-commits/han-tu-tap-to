# CẤU HÌNH CƠ SỞ DỮ LIỆU & ĐĂNG NHẬP CLOUD (SUPABASE)
# Tạo dự án miễn phí tại: https://supabase.com
# Vào Project Settings -> API để lấy URL và Anon Key dán vào dưới đây:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CẤU HÌNH CỔNG THANH TOÁN TỰ ĐỘNG SEPAY
# Đăng ký tài khoản tại: https://my.sepay.vn
# Điền số tài khoản ngân hàng và ngân hàng của bạn
VITE_SEPAY_BANK_NAME=MBBank
VITE_SEPAY_ACCOUNT_NO=
VITE_SEPAY_ACCOUNT_NAME=
